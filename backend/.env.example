# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/gameguard

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Email (Nodemailer - use Gmail App Password or Mailtrap for dev)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_password
EMAIL_FROM=noreply@gameguard.io

# 2FA
OTP_SECRET_KEY=gameguard_2fa_secret_base

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
